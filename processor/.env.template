CTP_AUTH_URL=https://auth.[region].commercetools.com
CTP_API_URL=https://api.[region].commercetools.com
CTP_SESSION_URL=https://session.[region].commercetools.com
CTP_CHECKOUT_URL=https://checkout.[region].commercetools.com
CTP_PROJECT_KEY=[composable-commerce-project-key]

CTP_CLIENT_ID=[composable-commerce-client-id]
CTP_CLIENT_SECRET=[composable-commerce-client-secret]

# Required even though processor's own CT client is configured via the full URLs above, not a
# region: common-connect's PayPal access-token caching (getCachedAccessToken/cacheAccessToken)
# and merchant settings lookup (getSettings) build their own separate CT client from CTP_REGION
# (see common-connect/src/middleware/auth.middleware.ts), independent of processor's paymentSDK.
# Without it, any processor code path that calls a real PayPal API function (e.g. createOrder) or
# reads merchant settings fails with a DNS error on "auth.undefined.commercetools.com". Same value
# as the [region] placeholder above, e.g. europe-west1.gcp for
# https://auth.europe-west1.gcp.commercetools.com.
CTP_REGION=[region]

# Also required by that same separate CT client — must match the scope actually granted to
# CTP_CLIENT_ID (see it in the Merchant Center under Developer Settings > API clients, or reuse
# the value already set for the same client in paypal-commercetools-extension's/-events' own
# .env, e.g. CTP_SCOPE=manage_project:[composable-commerce-project-key]). If unset, this client
# falls back to the literal scope string "default", which commercetools rejects with
# "Malformed parameter: scope: Invalid scope" instead of a clearer missing-env-var error.
CTP_SCOPE=[composable-commerce-client-scope]

CTP_JWKS_URL=https://mc-api.[region].commercetools.com/.well-known/jwks.json
CTP_JWT_ISSUER=https://mc-api.[region].commercetools.com

# Optional — custom type keys for the PayPal custom fields shared with extension
# For local tests if you use extension as well - set both same or keep unset.
# For deployments it is shared inside inheritAs
#PAYMENT_TYPE_KEY=paypal-payment-type
#CUSTOMER_TYPE_KEY=paypal-customer-type
#PAYMENT_INTERACTION_TYPE_KEY=paypal-payment-interaction-type

# Optional, default: info
LOGGER_LEVEL=info
# Optional, default: 5000 (ms)
HEALTH_CHECK_TIMEOUT=5000

PAYPAL_CLIENT_ID=[PayPal client id]
PAYPAL_CLIENT_SECRET=[PayPal client secret]
PAYPAL_ENVIRONMENT=Sandbox#Production

#This part of environmental variables is only for processor
# Enable vault payment methods
STORED_PAYMENT_METHODS_ENABLED=true

# Optional, default: PayPal — the CT payment interface name stored payment methods are recorded
# under. Only worth changing if this project has more than one payment interface.
STORED_PAYMENT_METHODS_PAYMENT_INTERFACE=PayPal
# Optional — interface account identifier for stored payment methods, if required by your setup.
STORED_PAYMENT_METHODS_INTERFACE_ACCOUNT=

MERCHANT_RETURN_URL=[Merchant-website-return-url]

# Optional — PayPal-Express-only override for the buyer redirect after authorizeOrder()/
# captureOrder() approval. Falls back to MERCHANT_RETURN_URL/the session return url when unset.
PAYPAL_ONAPPROVE_PREFIX=[Merchant-website-approve-url]

# Optional, default: false. When true, the buyer is redirected to PAYPAL_ONAPPROVE_PREFIX
# (or MERCHANT_RETURN_URL/session return url if unset) immediately on approval,
# before authorizeOrder()/captureOrder() is ever called.
# See enabler/README.md's "PayPal-Express legal-review requirement" section.
PAYPAL_REDIRECT_ON_APPROVE=false

# Optional. Merchant overrides for PayPal wallet experience_context (payment_source.paypal.
# experience_context on the Orders v2 createOrder request) as a flat JSON object — any key set
# here always wins over this connector's own computed defaults. Built-in defaults: user_action is
# PAY_NOW, except CONTINUE for Express orders with a review-step redirect configured
# (PAYPAL_REDIRECT_ON_APPROVE/PAYPAL_ONAPPROVE_PREFIX); payment_method_preference is
# IMMEDIATE_PAYMENT_REQUIRED (excludes non-immediate buyer payment methods, e.g. eChecks — set to
# UNRESTRICTED here to allow them). Add other experience_context fields here as needed, e.g.:
# {"payment_method_preference":"UNRESTRICTED","brand_name":"My Store"}
# Also applies to PayUponInvoice's own payment_source.pay_upon_invoice.experience_context (a
# different object, required by PayPal there) — its built-in defaults are a placeholder
# customer_service_instructions message and locale "de-DE" (or the cart's own locale, when set);
# override with e.g. {"customer_service_instructions":["Contact us at support@mystore.example"]}.
PAYPAL_ORDER_EXPERIENCE_CONTEXT={}

# Per-component overrides, keyed by componentType plus a dedicated
# "PayPalExpress" for express builder — then the props relevant to it.
# Anything omitted — a whole componentType or just one prop within one — falls back first to
# general settings (where one exists — style only, not fundingSources/components), then to the
# enabler's own built-in default. Props are each used as-is when present — no merging with what the
# fallback would otherwise have supplied for that same key. Example, overriding only
# PayPalExpress's funding sources and CardFields' script components (PayPal keeps every default):
# {"PayPalExpress":{"fundingSources":["paypal","paylater"]},"CardFields":{"components":"card-fields"}}
PAYPAL_BUTTON_CONFIG={}

# Optional field-level overrides layered on top of processor's own base merchant settings —
# common-connect's CUSTOM_OBJECT_DEFAULT_VALUES (button style, PayLater messaging, 3DS option, etc.;
# blue is the default button color). That base, plus any overrides set here, is used for whichever
# fields the paypal-commercetools-connector/settings custom object doesn't supply — e.g. it's
# entirely unavailable. Fields the custom object does supply always win over both this and the
# base. Format: JSON object matching (a subset of) common-connect's PayPalSettings shape.
PAYPAL_SETTINGS={}

# PayPal Express's own PayPal JS SDK script-level options — currency, funding sources, locale,
# vault, etc. In the old standalone client these were passed directly as component props by the
# merchant's own frontend code; commercetools Checkout mounts the enabler itself, so there's no
# merchant frontend code path left to supply them. Format: flat JSON object matching (a subset of)
# @paypal/paypal-js's PayPalScriptOptions, e.g.:
# Passed through to the enabler as-is — no processor-side defaulting. currency is overridden per
# request from the cart (its total price's currencyCode) whenever available.
PAYPAL_EXPRESS_SDK_OPTIONS={}

# PayPal JS SDK script-level options shared by every *standard* PayPal-brand/CardFields/ApplePay
# component — every individual funding-source button (PayPal, Sepa, PayLater, PayPalCreditCard,
# Venmo, Credit, plus the active local-payment-method subset Ideal/Bancontact/Eps/MyBank/P24/Blik),
# AllButtons, CardFields, ApplePay, and CardFieldsStored too — NOT PayPal Express (mounted on a
# different page, configured independently via PAYPAL_EXPRESS_SDK_OPTIONS/PAYPAL_BUTTON_CONFIG).
# The whole shape is flat, e.g:
# PAYPAL_STANDARD_SCRIPT_OPTIONS={"currency":"USD","buyerCountry":"US","disableFunding":["sepa"]}
# Any field @paypal/paypal-js's PayPalScriptOptions accepts is valid here (currency, buyerCountry,
# locale, vault, components, disableFunding, enableFunding, ...) — `currency`/`buyerCountry` are
# additionally overlaid per request from the cart (its total price's currency, and its country field
# — buyerCountry only in sandbox, whenever available; this var's values only take effect as a fallback.
# `components` is narrowed further per request by the paypal-commercetools-connector/settings
# custom object's acceptCredit flag (removes "card-fields" when false, which also disables
# CardFieldsStored, not just standard CardFields) — no settings flag exists for "applepay"/
# "googlepay", so their inclusion is controlled by this list alone (or checkout App in merchant
# center).
# Layered on top of this connector's own built-in default (components: every component it supports;
# no disableFunding/enableFunding by default — an unset value here means the buyer sees whatever PayPal's own SDK
 # considers eligible) the same way PAYPAL_SETTINGS layers over its own base — an unset
# or {} value here keeps that default; only the keys you actually set here override it.
# Every dedicated individual-funding-source button (Sepa/Venmo/Ideal/etc.) correctly reports itself
# unavailable to commercetools Checkout — rather than being listed and then silently failing to
# render — whenever its own funding source is excluded here via disableFunding.
# `enableFunding` (optional) force-includes a funding source that PayPal's SDK would otherwise
# treat as ineligible-by-default for the general/AllButtons listing specifically — it has no effect
# on a dedicated single-funding-source button, which is unaffected by enableFunding either way.
# Setting the SAME funding source in both enableFunding and disableFunding is rejected outright:
# PayPalPaymentService.config() throws rather than silently sending PayPal a self-contradictory
# script.
PAYPAL_STANDARD_SCRIPT_OPTIONS={}

